{
  "name": "ShrinkIt",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "ShrinkableTemplates": {
        "$path": "assets/ShrinkableTemplates"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": {
        "$path": "src/ServerScriptService/Main.server.lua"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ClientMain": {
          "$path": "src/StarterPlayerScripts/ClientMain.client.lua"
        },
        "ClientModules": {
          "$path": "src/StarterPlayerScripts/ClientModules"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true
        }
      },
      "ShrinkItMap": {
        "$path": "map/ShrinkItMap.model.json"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future"
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "CreateDefaultTextChannels": false
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Chasers": {
        "$path": "assets/Chasers"
      },
      "AssetPack": {
        "$path": "assets/Pack"
      }
    }
  }
}
