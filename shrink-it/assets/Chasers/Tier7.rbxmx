    <Item class="Script" referent="RBX84032FACF5664440911FF9613661E4EE">
      <Properties>
        <string name="Name">RunAndAttack</string>
        <ProtectedString name="Source">-- Animated chaser controller. Place the complete NPC model in Workspace to activate it.
-- Templates in ServerStorage do not run. No uploaded animation assets are required.
-- Set ChaseEnabled=false or mark a player/character SafeZone=true to stop attacks.
-- Optional TargetOverride ObjectValue is useful for controlled Studio dummy testing.

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
if not RunService:IsServer() then return end

local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid", 10)
local root = npc:WaitForChild("HumanoidRootPart", 10)
if not npc:IsA("Model") or not humanoid or not humanoid:IsA("Humanoid")
	or not root or not root:IsA("BasePart") then
	warn("Animated chaser needs a Model, Humanoid and HumanoidRootPart:", npc:GetFullName())
	npc:SetAttribute("ControllerReady", false)
	npc:SetAttribute("ControllerError", "Missing Humanoid or HumanoidRootPart")
	return
end

local function numberAttribute(name, fallback, minimum, maximum)
	local value = npc:GetAttribute(name)
	if typeof(value) ~= "number" or value ~= value then value = fallback end
	return math.clamp(value, minimum, maximum)
end

local home = npc:GetAttribute("HomePosition")
if typeof(home) ~= "Vector3" then home = root.Position end
npc:SetAttribute("SpawnPosition", home)
if npc:GetAttribute("ChaseEnabled") == nil then npc:SetAttribute("ChaseEnabled", true) end
humanoid.AutoRotate = true
humanoid.RequiresNeck = false
humanoid.BreakJointsOnDeath = false
humanoid.WalkSpeed = numberAttribute("ChaseSpeed", 38, 5, 120)

for _, descendant in npc:GetDescendants() do
	if descendant:IsA("BasePart") then descendant.Anchored = false end
end
local ownershipOK = pcall(function() root:SetNetworkOwner(nil) end)
npc:SetAttribute("ServerOwned", ownershipOK)

local motors = {}
local baseC0 = {}
for _, descendant in npc:GetDescendants() do
	if descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
		motors[descendant.Name] = descendant
		baseC0[descendant.Name] = descendant.C0
	end
end

local function pose(name, rotation)
	local motor = motors[name]
	if motor and motor.Parent then motor.C0 = baseC0[name] * rotation end
end

local currentState = "Idle"
local currentTarget = nil
local nextAttackAt = 0
local attackStartedAt = 0
local attackEndsAt = 0
local hitAt = 0
local hitPending = false
local attackTarget = nil
local attackCount = 0
local hitsLanded = 0
local damageDealt = 0
local pathRequests = 0
local failedPaths = 0
local alive = true
local path = nil
local waypoints = nil
local waypointIndex = 2
local blockedConnection = nil
local plannedGoal = nil
local nextPathAt = 0
local pathBusy = false
local pathEpoch = 0
local nextMoveAt = 0
local lastMoveGoal = nil
local phase = 0
local thinkAccumulator = 0
local animationAccumulator = 0
local heartbeatConnection

local function setState(state)
	if state ~= currentState then
		currentState = state
		npc:SetAttribute("CurrentState", state)
		npc:SetAttribute("StateChangedAt", workspace:GetServerTimeNow())
	end
end

local function clearPath()
	pathEpoch += 1
	if blockedConnection then blockedConnection:Disconnect(); blockedConnection = nil end
	path = nil
	waypoints = nil
	plannedGoal = nil
end

local function targetParts(character)
	if not character or not character:IsA("Model") or not character:IsDescendantOf(workspace)
		or character == npc or character:GetAttribute("SafeZone") == true then return nil end
	local player = Players:GetPlayerFromCharacter(character)
	if player and (player.Character ~= character or player:GetAttribute("SafeZone") == true) then return nil end
	local targetHumanoid = character:FindFirstChildOfClass("Humanoid")
	local targetRoot = character:FindFirstChild("HumanoidRootPart")
	if targetHumanoid and targetHumanoid.Health &gt; 0 and targetRoot and targetRoot:IsA("BasePart") then
		return targetHumanoid, targetRoot
	end
	return nil
end

local function targetIsInLeash(character)
	local targetHumanoid, targetRoot = targetParts(character)
	if not targetHumanoid then return nil end
	local loseRadius = numberAttribute("LoseTargetRadius", 120, 10, 100000)
	local leash = numberAttribute("HomeLeash", 160, 10, 100000)
	if (targetRoot.Position - root.Position).Magnitude &gt; loseRadius
		or (targetRoot.Position - home).Magnitude &gt; leash then return nil end
	return targetHumanoid, targetRoot
end

local function chooseTarget()
	local override = npc:FindFirstChild("TargetOverride")
	if override and override:IsA("ObjectValue") and override.Value then
		if targetIsInLeash(override.Value) then return override.Value end
		return nil
	end
	if currentTarget and targetIsInLeash(currentTarget) then return currentTarget end
	local radius = numberAttribute("DetectionRadius", 80, 5, 500)
	local bestCharacter = nil
	local bestDistance = radius
	for _, player in Players:GetPlayers() do
		local targetHumanoid, targetRoot = targetIsInLeash(player.Character)
		if targetHumanoid then
			local distance = (targetRoot.Position - root.Position).Magnitude
			if distance &lt; bestDistance then bestDistance = distance; bestCharacter = player.Character end
		end
	end
	return bestCharacter
end

local function lineOfSight(character, position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { npc }
	params.RespectCanCollide = true
	local result = workspace:Raycast(root.Position, position - root.Position, params)
	return not result or (character and result.Instance:IsDescendantOf(character))
end

local function canHit(character)
	local targetHumanoid, targetRoot = targetIsInLeash(character)
	if not targetHumanoid or npc:GetAttribute("ChaseEnabled") == false or humanoid.Health &lt;= 0 then return nil end
	local range = numberAttribute("AttackRange", 4.5, 2, 20)
	local delta = targetRoot.Position - root.Position
	local visualHeight = npc:GetAttribute("VisualHeight")
	if typeof(visualHeight) ~= "number" then visualHeight = 6 end
	local verticalReach = numberAttribute("AttackVerticalReach", math.max(4.5, visualHeight * 0.6), 2, 30)
	if Vector3.new(delta.X, 0, delta.Z).Magnitude &gt; range or math.abs(delta.Y) &gt; verticalReach
		or not lineOfSight(character, targetRoot.Position) then return nil end
	return targetHumanoid, targetRoot
end

local function stopMoving()
	humanoid:Move(Vector3.zero, false)
	lastMoveGoal = nil
end

local function moveTo(goal, now)
	if now &gt;= nextMoveAt or not lastMoveGoal or (goal - lastMoveGoal).Magnitude &gt; 3 then
		nextMoveAt = now + 0.15
		lastMoveGoal = goal
		humanoid:MoveTo(goal)
	end
end

local function requestPath(goal, now)
	if pathBusy or now &lt; nextPathAt then return end
	if plannedGoal and waypoints and (goal - plannedGoal).Magnitude &lt; 8 then return end
	nextPathAt = now + 0.8
	pathBusy = true
	pathRequests += 1
	npc:SetAttribute("PathRequests", pathRequests)
	local epoch = pathEpoch
	local origin = root.Position
	task.spawn(function()
		local newPath = PathfindingService:CreatePath({
			AgentRadius = numberAttribute("AgentRadius", math.max(1, math.ceil(root.Size.X * 0.45)), 1, 12),
			AgentHeight = numberAttribute("AgentHeight", math.max(5, root.Size.Y + humanoid.HipHeight * 2), 2, 30),
			AgentCanJump = true,
			WaypointSpacing = 4,
		})
		local ok = pcall(function() newPath:ComputeAsync(origin, goal) end)
		pathBusy = false
		if not alive or epoch ~= pathEpoch or not npc:IsDescendantOf(workspace) then return end
		if ok and newPath.Status == Enum.PathStatus.Success then
			if blockedConnection then blockedConnection:Disconnect() end
			path = newPath
			waypoints = newPath:GetWaypoints()
			waypointIndex = 2
			plannedGoal = goal
			blockedConnection = newPath.Blocked:Connect(function(index)
				if path == newPath and index &gt;= waypointIndex then clearPath() end
			end)
			npc:SetAttribute("LastPathStatus", "Success")
		else
			failedPaths += 1
			npc:SetAttribute("FailedPaths", failedPaths)
			npc:SetAttribute("LastPathStatus", ok and newPath.Status.Name or "ComputeError")
			clearPath()
		end
	end)
end

local function navigate(goal, character, now)
	if lineOfSight(character, goal) then
		if waypoints or pathBusy then clearPath() end
		moveTo(goal, now)
		return
	end
	requestPath(goal, now)
	if waypoints then
		local waypoint = waypoints[waypointIndex]
		local threshold = math.max(2, humanoid.WalkSpeed * 0.07)
		while waypoint do
			local delta = waypoint.Position - root.Position
			if Vector3.new(delta.X, 0, delta.Z).Magnitude &gt; threshold or math.abs(delta.Y) &gt; 4 then break end
			waypointIndex += 1
			waypoint = waypoints[waypointIndex]
		end
		if waypoint then
			if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
			moveTo(waypoint.Position, now)
			return
		end
		clearPath()
	end
	-- A direct MoveTo keeps the NPC responsive while a path is computed or unavailable.
	moveTo(goal, now)
end

local function startAttack(character, now)
	local _, targetRoot = canHit(character)
	if not targetRoot or now &lt; nextAttackAt then return false end
	clearPath()
	stopMoving()
	humanoid.AutoRotate = false
	local horizontal = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
	if (horizontal - root.Position).Magnitude &gt; 0.05 then root.CFrame = CFrame.lookAt(root.Position, horizontal) end
	local windup = numberAttribute("AttackWindup", 0.25, 0.1, 0.8)
	attackStartedAt = now
	hitAt = now + windup
	attackEndsAt = now + windup + 0.3
	nextAttackAt = now + math.max(numberAttribute("AttackCooldown", 1.2, 0.6, 10), windup + 0.35)
	hitPending = true
	attackTarget = character
	attackCount += 1
	npc:SetAttribute("AttackCount", attackCount)
	npc:SetAttribute("LastAttackTime", workspace:GetServerTimeNow())
	setState("Attack")
	return true
end

local function cancelAttack()
	hitPending = false
	attackTarget = nil
	attackEndsAt = 0
	humanoid.AutoRotate = true
end

local function think(now)
	npc:SetAttribute("DistanceFromHome", (root.Position - home).Magnitude)
	humanoid.WalkSpeed = numberAttribute("ChaseSpeed", 38, 5, 120)
	if npc:GetAttribute("ChaseEnabled") == false then
		cancelAttack()
		if currentState ~= "Idle" then clearPath() end
		currentTarget = nil
		npc:SetAttribute("TargetName", "")
		stopMoving()
		setState("Idle")
		return
	end
	if now &lt; attackEndsAt then
		if not targetIsInLeash(attackTarget) then cancelAttack() else return end
	end
	humanoid.AutoRotate = true
	local target = chooseTarget()
	if target ~= currentTarget then clearPath(); currentTarget = target end
	npc:SetAttribute("TargetName", target and target.Name or "")
	if target then
		local _, targetRoot = targetParts(target)
		if canHit(target) then
			if startAttack(target, now) then return end
			stopMoving()
			setState("Chase")
		else
			setState("Chase")
			navigate(targetRoot.Position, target, now)
		end
	elseif (root.Position - home).Magnitude &gt; 3 then
		setState("Return")
		navigate(home, nil, now)
	else
		if currentState ~= "Idle" then clearPath() end
		stopMoving()
		setState("Idle")
	end
end

local function animate(dt, now)
	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local running = (currentState == "Chase" or currentState == "Return") and speed &gt; 1
	phase += dt * (running and math.clamp(speed * 0.45, 7, 22) or 2)
	local stride = running and math.sin(phase) or 0
	local breathe = running and 0 or math.sin(phase) * 0.025
	pose("Neck", CFrame.Angles(breathe, 0, running and stride * 0.025 or 0))
	pose("Waist", CFrame.Angles(running and -0.08 or breathe, 0, running and stride * 0.035 or 0))
	pose("RootJoint", CFrame.Angles(running and -0.045 or 0, 0, running and stride * 0.025 or 0))
	pose("RightShoulder", CFrame.Angles(-stride * 0.75 + breathe, 0, -0.07))
	pose("LeftShoulder", CFrame.Angles(stride * 0.75 - breathe, 0, 0.07))
	pose("RightHip", CFrame.Angles(stride * 0.75, 0, 0))
	pose("LeftHip", CFrame.Angles(-stride * 0.75, 0, 0))
	if currentState == "Attack" and now &lt; attackEndsAt then
		local windup = math.max(hitAt - attackStartedAt, 0.001)
		local swing
		if now &lt; hitAt then swing = -0.3 - 0.75 * math.clamp((now - attackStartedAt) / windup, 0, 1)
		else swing = 2.15 * (1 - math.clamp((now - hitAt) / 0.3, 0, 1)) end
		pose("RightShoulder", CFrame.Angles(swing, 0.12, -0.16))
		pose("LeftShoulder", CFrame.Angles(0.5, -0.1, 0.16))
		pose("Waist", CFrame.Angles(0, swing * 0.12, 0))
	end
end

local function cleanUp()
	if not alive then return end
	alive = false
	clearPath()
	cancelAttack()
	if heartbeatConnection then heartbeatConnection:Disconnect() end
	for name, motor in motors do if motor.Parent then motor.C0 = baseC0[name] end end
	npc:SetAttribute("ControllerReady", false)
	npc:SetAttribute("CurrentState", humanoid.Health &lt;= 0 and "Dead" or "Stopped")
end

npc:SetAttribute("ControllerReady", true)
npc:SetAttribute("CurrentState", "Idle")
npc:SetAttribute("AttackCount", 0)
npc:SetAttribute("HitsLanded", 0)
npc:SetAttribute("DamageDealt", 0)
npc:SetAttribute("PathRequests", 0)
npc:SetAttribute("FailedPaths", 0)
npc:SetAttribute("TargetName", "")
humanoid.Died:Connect(cleanUp)
script.Destroying:Connect(cleanUp)

heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
	if not alive then return end
	if not npc:IsDescendantOf(workspace) or not root.Parent or humanoid.Health &lt;= 0 then cleanUp(); return end
	local now = os.clock()
	if hitPending and now &gt;= hitAt then
		hitPending = false
		local targetHumanoid = canHit(attackTarget)
		if targetHumanoid then
			local healthBefore = targetHumanoid.Health
			targetHumanoid:TakeDamage(numberAttribute("AttackDamage", 15, 0, 1000))
			local damage = math.max(0, healthBefore - targetHumanoid.Health)
			if damage &gt; 0 then
				hitsLanded += 1
				damageDealt += damage
				npc:SetAttribute("HitsLanded", hitsLanded)
				npc:SetAttribute("DamageDealt", damageDealt)
				npc:SetAttribute("LastHitTarget", attackTarget.Name)
				npc:SetAttribute("LastHitTime", workspace:GetServerTimeNow())
			end
		end
	end
	thinkAccumulator += dt
	if thinkAccumulator &gt;= 0.12 then thinkAccumulator = 0; think(now) end
	animationAccumulator += dt
	if animationAccumulator &gt;= 0.05 then
		local animationDt = animationAccumulator
		animationAccumulator = 0
		animate(animationDt, now)
	end
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
</roblox>