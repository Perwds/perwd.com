  if not active then return end
  if not npc:IsDescendantOf(workspace) or not root.Parent or (humanoid and humanoid.Health &lt;= 0) then stop(); return end
  if not sleeping then return end
  elapsed += dt; accumulator += dt
  if accumulator &gt;= .05 then accumulator = 0; animate() end
 end))
 if humanoid then table.insert(connections, humanoid.Died:Connect(stop)) end
 table.insert(connections, npc.Destroying:Connect(stop))
 npc:SetAttribute("SleepControllerReady", true)
 setSleeping(npc:GetAttribute("Sleeping") == true)
 if sleeping then animate() end
 return {Stop = stop}
end
return SleepAnimator
