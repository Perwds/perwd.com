 for _, name in ipairs({"SnoreSoundId", "SnoreVolume", "SnorePlaybackSpeed", "SnoreDistance", "SleepSoundEnabled"}) do
  table.insert(connections, npc:GetAttributeChangedSignal(name):Connect(syncSound))
