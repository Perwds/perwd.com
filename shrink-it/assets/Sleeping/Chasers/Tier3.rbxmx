 label.Font = Enum.Font.GothamBold; label.TextScaled = true; label.TextColor3 = Color3.fromRGB(183, 215, 255)
 label.TextStrokeColor3 = Color3.fromRGB(34, 42, 69); label.TextStrokeTransparency = .35; label.Text = "Z z z"; label.Parent = billboard

 local function number(name, default, low, high)
  local value = npc:GetAttribute(name)
  if typeof(value) ~= "number" or value ~= value then value = default end
  return math.clamp(value, low, high)
