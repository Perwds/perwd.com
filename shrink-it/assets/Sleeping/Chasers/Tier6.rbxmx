    <Item class="ModuleScript" referent="RBXE6A72F26D5D149F88E3687D2F06B0477">
      <Properties>
        <string name="Name">SleepAnimator</string>
        <ProtectedString name="Source">-- Shared sleep animation for a rigged chaser or an anchored shopkeeper.
-- The complete model includes this ModuleScript, a Snore Sound and SetSleeping API.
local RunService = game:GetService("RunService")
local SleepAnimator = {}

function SleepAnimator.Start(npc, rig)
 local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("SleepAnchor")
 local head = npc:FindFirstChild("Head", true)
 local humanoid = npc:FindFirstChildOfClass("Humanoid")
 local sound = npc:FindFirstChild("Snore", true)
 local api = npc:WaitForChild("SetSleeping")
 local changed = npc:WaitForChild("SleepChanged")
 assert(root and head and sound, "Sleep asset needs a root, head and Snore Sound")
 local motors = rig and rig.motors
 local baseC0 = rig and rig.baseC0
 local sleeping, active = false, true
 local saved
 local elapsed, accumulator, breath = 0, 0, 0
 local connections = {}
 local rest, groups = {}, {}
 local anchorFrame = root.CFrame
 local function localPosition(part)
  return anchorFrame:PointToObjectSpace(part.Position)
 end
 local lower = npc:FindFirstChild("LowerTorso", true)
 local waistPivot = lower and localPosition(lower) or Vector3.zero
 local neckPivot = localPosition(head) - Vector3.new(0, head.Size.Y * .45, 0)
 local shoulders = {}
 if not motors then
  for _, part in ipairs(npc:GetDescendants()) do
   if part:IsA("BasePart") and part ~= root then
    rest[part] = anchorFrame:ToObjectSpace(part.CFrame)
    local name = part.Name:lower()
    local group = "Body"
    if name == "head" or name:find("hair") or name:find("cap") or name:find("crown") or name:find("hat") then group = "Head"
    elseif name:find("left") and (name:find("arm") or name:find("hand")) then group = "LeftArm"
    elseif name:find("right") and (name:find("arm") or name:find("hand")) then group = "RightArm"
    elseif name:find("leg") or name:find("foot") then group = "Legs" end
    groups[part] = group
   end
  end
  for _, side in ipairs({"Left", "Right"}) do
   local arm = npc:FindFirstChild(side .. "UpperArm", true)
   shoulders[side .. "Arm"] = arm and localPosition(arm) + Vector3.new(0, arm.Size.Y * .4, 0) or waistPivot
  end
 end
 local billboard = Instance.new("BillboardGui")
 billboard.Name = "SleepZzz"; billboard.Adornee = head
 billboard.Size = UDim2.fromOffset(110, 65); billboard.StudsOffset = Vector3.new(0, head.Size.Y * .7 + .8, 0)
 billboard.MaxDistance = 70; billboard.AlwaysOnTop = false; billboard.Enabled = false; billboard.Parent = head
 local label = Instance.new("TextLabel")
 label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1
 label.Font = Enum.Font.GothamBold; label.TextScaled = true; label.TextColor3 = Color3.fromRGB(183, 215, 255)
 label.TextStrokeColor3 = Color3.fromRGB(34, 42, 69); label.TextStrokeTransparency = .35; label.Text = "Z z z"; label.Parent = billboard

 local function number(name, default, low, high)
  local value = npc:GetAttribute(name)
  if typeof(value) ~= "number" or value ~= value then value = default end
  return math.clamp(value, low, high)
 end
 local function syncSound()
  local id = npc:GetAttribute("SnoreSoundId")
  if typeof(id) == "string" and id ~= "" and sound.SoundId ~= id then sound.SoundId = id end
  sound.Volume = number("SnoreVolume", .38, 0, 2)
  sound.PlaybackSpeed = number("SnorePlaybackSpeed", 1, .45, 1.6)
  sound.RollOffMinDistance = 5; sound.RollOffMaxDistance = number("SnoreDistance", 45, 8, 120)
  sound.RollOffMode = Enum.RollOffMode.InverseTapered; sound.Looped = true
  local audible = sleeping and npc:GetAttribute("SleepSoundEnabled") ~= false
  if audible and not sound.Playing then sound:Play()
  elseif not audible and sound.Playing then sound:Stop() end
 end
 local function restorePose()
  if motors then
   for name, motor in pairs(motors) do if motor.Parent then motor.C0 = baseC0[name] end end
  else
   for part, cf in pairs(rest) do if part.Parent then part.CFrame = root.CFrame * cf end end
  end
 end
 local function setSleeping(value)
  if sleeping == value then syncSound(); return end
  sleeping = value
  if sleeping then
   elapsed = 0
   saved = {anchored = root.Anchored, walkSpeed = humanoid and humanoid.WalkSpeed, autoRotate = humanoid and humanoid.AutoRotate}
   if humanoid then humanoid:Move(Vector3.zero, false); humanoid.WalkSpeed = 0; humanoid.AutoRotate = false end
   root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero; root.Anchored = true
   if rig and rig.onSleep then rig.onSleep() end
  else
   restorePose()
   if saved then
    root.Anchored = saved.anchored
    if humanoid then humanoid.WalkSpeed = saved.walkSpeed; humanoid.AutoRotate = saved.autoRotate end
    if humanoid and not root.Anchored then pcall(function() root:SetNetworkOwner(nil) end) end
   end
   if rig and rig.onWake then rig.onWake() end
  end
  billboard.Enabled = sleeping and npc:GetAttribute("ShowSleepZzz") ~= false
  syncSound()
