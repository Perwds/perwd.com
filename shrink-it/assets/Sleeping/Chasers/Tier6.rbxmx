        <ProtectedString name="Source">-- Animation/audio asset controller; connect sleeping/waking to your existing NPC logic.
local npc = script.Parent
local motors, baseC0 = {}, {}
for _, joint in ipairs(npc:GetDescendants()) do
 if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
  motors[joint.Name] = joint; baseC0[joint.Name] = joint.C0
 end
end
local rig = next(motors) and {motors = motors, baseC0 = baseC0} or nil
local controller = require(npc:WaitForChild("SleepAnimator")).Start(npc, rig)
script.Destroying:Connect(controller.Stop)
