        <string name="Name">SleepSoundClient</string>
        <ProtectedString name="Source">-- PlaybackSpeed is local to each listener, so apply the NPC's pitch attribute on clients.
local npc = script.Parent
local sound = npc:WaitForChild("Head"):WaitForChild("Snore")
local function syncPitch()
 local speed = npc:GetAttribute("SnorePlaybackSpeed")
 if typeof(speed) ~= "number" or speed ~= speed then speed = 1 end
 sound.PlaybackSpeed = math.clamp(speed, .45, 1.6)
end
syncPitch()
local connection = npc:GetAttributeChangedSignal("SnorePlaybackSpeed"):Connect(syncPitch)
script.Destroying:Connect(function()connection:Disconnect()end)
