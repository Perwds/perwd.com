  motors[joint.Name] = joint; baseC0[joint.Name] = joint.C0
 end
end
local rig = next(motors) and {motors = motors, baseC0 = baseC0} or nil
local controller = require(npc:WaitForChild("SleepAnimator")).Start(npc, rig)
script.Destroying:Connect(controller.Stop)
