","index":23,"count":24}},{"name":"HaloSegment","animation":{"type":"aura","phase":0.0}},{"name":"HaloSegment_02","animation":{"type":"aura","phase":0.08}},{"name":"HaloSegment_03","animation":{"type":"aura","phase":0.16}},{"name":"HaloSegment_04","animation":{"type":"aura","phase":0.24}},{"name":"HaloSegment_05","animation":{"type":"aura","phase":0.32}},{"name":"HaloSegment_06","animation":{"type":"aura","phase":0.4}},{"name":"HaloSegment_07","animation":{"type":"aura","phase":0.48}},{"name":"HaloSegment_08","animation":{"type":"aura","phase":0.56}},{"name":"HaloSegment_09","animation":{"type":"aura","phase":0.55}},{"name":"HaloSegment_10","animation":{"type":"aura","phase":0.63}},{"name":"HaloSegment_11","animation":{"type":"aura","phase":0.7100000000000001}},{"name":"HaloSegment_12","animation":{"type":"aura","phase":0.79}},{"name":"HaloSegment_13","animation":{"type":"aura","phase":0.8700000000000001}},{"name":"HaloSegment_14","animation":{"type":"aura","phase":0.9500000000000001}},{"name":"HaloSegment_15","animation":{"type":"aura","phase":1.03}},{"name":"HaloSegment_16","animation":{"type":"aura","phase":1.11}},{"name":"EnergyMote","animation":{"type":"aura","phase":0.0}},{"name":"EnergyMote_02","animation":{"type":"aura","phase":0.63}},{"name":"EnergyMote_03","animation":{"type":"aura","phase":1.26}},{"name":"EnergyMote_04","animation":{"type":"aura","phase":1.8900000000000001}},{"name":"EnergyMote_05","animation":{"type":"aura","phase":2.52}},{"name":"EnergyMote_06","animation":{"type":"aura","phase":3.15}},{"name":"CrystalShard","animation":{"type":"aura","phase":-3.72}},{"name":"CrystalShard_02","animation":{"type":"aura","phase":1.7200000000000002}},{"name":"CrystalShard_03","animation":{"type":"aura","phase":-1.7200000000000002}},{"name":"CrystalShard_04","animation":{"type":"aura","phase":3.72}}]}</string>
