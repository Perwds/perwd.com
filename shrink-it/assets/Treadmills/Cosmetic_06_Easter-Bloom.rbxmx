    <Item class="Script" referent="RBX000000F4">
      <Properties>
        <string name="Name">TreadmillAnimation</string>
        <ProtectedString name="Source">-- Treadmill Cosmetic Set runtime. Put this Script inside one treadmill Model.
-- Set Script.RunContext to Enum.RunContext.Client. All animated parts stay anchored.
-- Configuration can be a child StringValue named AnimationConfig containing JSON,
-- or model belt attributes and part AnimationType/AnimationIndex/AnimationCount attributes.
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local model = script.Parent
if not model:IsA("Model") then return end

local config = {belt = {}, parts = {}}
local configValue = script:FindFirstChild("AnimationConfig")
if configValue and configValue:IsA("StringValue") then
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, configValue.Value)
    if ok and type(decoded) == "table" then config = decoded end
end
local belt = config.belt or {}
local halfLength = belt.halfLength or model:GetAttribute("BeltHalfLength") or 3.1
local centerY = belt.centerY or model:GetAttribute("BeltCenterY") or 0.46
local radius = belt.radius or model:GetAttribute("BeltRadius") or 0.18
local speed = belt.speed or model:GetAttribute("BeltSpeed") or 1.6
local angle = belt.angle or model:GetAttribute("BeltAngle") or 0
local origin = belt.origin or {0, model:GetAttribute("BeltLift") or 0, 0}
local beltTransform = CFrame.new(origin[1] or 0, origin[2] or 0, origin[3] or 0) * CFrame.Angles(angle, 0, 0)
local perimeter = 4 * halfLength + 2 * math.pi * radius
local configured = {}
for _, entry in ipairs(config.parts or {}) do
    if entry.animation then configured[entry.name] = entry.animation end
end
local animated = {}
local initialPivot = model:GetPivot()
for _, part in ipairs(model:GetDescendants()) do
    if part:IsA("BasePart") then
        local a = configured[part.Name]
        if not a and part:GetAttribute("AnimationType") then
            a = {
                type = part:GetAttribute("AnimationType"),
                index = part:GetAttribute("AnimationIndex") or 0,
                count = part:GetAttribute("AnimationCount") or 28,
                phase = part:GetAttribute("AnimationPhase") or 0,
                sign = part:GetAttribute("AnimationSign") or 1,
            }
        end
        if a then
            table.insert(animated, {
                part = part, a = a,
                cframe = initialPivot:ToObjectSpace(part.CFrame),
                size = part.Size, transparency = part.Transparency,
            })
        end
    end
end
local function beltPose(distance)
    local d = distance % perimeter
    if d &lt; 2 * halfLength then
        return centerY + radius, -halfLength + d, 0
    elseif d &lt; 2 * halfLength + math.pi * radius then
        local theta = (d - 2 * halfLength) / radius
        return centerY + radius * math.cos(theta), halfLength + radius * math.sin(theta), theta
    elseif d &lt; 4 * halfLength + math.pi * radius then
        local localD = d - 2 * halfLength - math.pi * radius
        return centerY - radius, halfLength - localD, math.pi
    else
        local theta = (d - 4 * halfLength - math.pi * radius) / radius
        return centerY - radius * math.cos(theta), -halfLength - radius * math.sin(theta), math.pi + theta
    end
end
local elapsed = 0
local connection
connection = RunService.RenderStepped:Connect(function(dt)
    if not model.Parent then connection:Disconnect() return end
    elapsed += dt
    local pivot = model:GetPivot()
    for _, entry in ipairs(animated) do
        local part, a = entry.part, entry.a
        if part.Parent then
            if a.type == "beltSlat" then
                local distance = (a.index or 0) / (a.count or 28) * perimeter + elapsed * speed
                local y, z, turn = beltPose(distance)
                part.CFrame = pivot * beltTransform * CFrame.new(0, y, z) * CFrame.Angles(turn, 0, 0)
            elseif a.type == "roller" then
                part.CFrame = pivot * entry.cframe * CFrame.Angles((a.sign or 1) * elapsed * speed / radius, 0, 0)
            elseif a.type == "float" or a.type == "orbit" or a.type == "spin" then
                local fraction = (elapsed * speed / perimeter) % 1
                local theta = fraction * math.pi * 2 * (a.cycles or 1) + (a.phase or 0)
                local phase = a.phase or 0
                local delta = Vector3.zero
                if a.type == "float" then
                    local amount = (a.amplitude or 0.15) * (math.sin(theta) - math.sin(phase))
                    local axis = a.axis or "y"
                    delta = axis == "x" and Vector3.new(amount,0,0) or axis == "z" and Vector3.new(0,0,amount) or Vector3.new(0,amount,0)
                elseif a.type == "orbit" then
                    delta = Vector3.new((a.radiusX or 2.8) * (math.cos(theta)-math.cos(phase)), (a.amplitude or 0)*(math.sin(theta)-math.sin(phase)), (a.radiusZ or 4.1) * (math.sin(theta)-math.sin(phase)))
                end
                local spin = CFrame.identity
                if a.type == "spin" or a.spin then
                    local turns = a.type == "spin" and (a.cycles or 1) or a.spin
                    local axisName = a.type == "spin" and (a.axis or "y") or "y"
                    local axis = axisName == "x" and Vector3.xAxis or axisName == "z" and Vector3.zAxis or Vector3.yAxis
                    spin = CFrame.fromAxisAngle(axis, fraction * math.pi * 2 * turns)
                end
                part.CFrame = pivot * CFrame.new(delta) * entry.cframe * spin
            elseif a.type == "aura" or a.type == "hologram" then
                local wave = math.sin(elapsed * 2.4 + (a.phase or 0))
                local amount = a.type == "aura" and 0.08 or 0.035
                part.Size = entry.size * (1 + wave * amount)
                part.Transparency = math.clamp(entry.transparency + wave * 0.07, 0, 0.95)
                part.CFrame = pivot * entry.cframe
            end
        end
    end
end)
</ProtectedString>
        <token name="RunContext">2</token>
        <bool name="Disabled">true</bool>
      </Properties>
      <Item class="StringValue" referent="RBX000000F5">
        <Properties>
          <string name="Name">AnimationConfig</string>
          <string name="Value">{"belt":{"halfLength":3.1,"centerY":0.43,"radius":0.18,"speed":2.25,"origin":[0,0.18,0],"angle":0.055},"parts":[{"name":"Roller","animation":{"type":"roller","sign":1}},{"name":"Roller_02","animation":{"type":"roller","sign":1}},{"name":"Tread_01","animation":{"type":"beltSlat","index":0,"count":24}},{"name":"Tread_02","animation":{"type":"beltSlat","index":1,"count":24}},{"name":"Tread_03","animation":{"type":"beltSlat","index":2,"count":24}},{"name":"Tread_04","animation":{"type":"beltSlat","index":3,"count":24}},{"name":"Tread_05","animation":{"type":"beltSlat","index":4,"count":24}},{"name":"Tread_06","animation":{"type":"beltSlat","index":5,"count":24}},{"name":"Tread_07","animation":{"type":"beltSlat","index":6,"count":24}},{"name":"Tread_08","animation":{"type":"beltSlat","index":7,"count":24}},{"name":"Tread_09","animation":{"type":"beltSlat","index":8,"count":24}},{"name":"Tread_10","animation":{"type":"beltSlat","index":9,"count":24}},{"name":"Tread_11","animation":{"type":"beltSlat","index":10,"count":24}},{"name":"Tread_12","animation":{"type":"beltSlat","index":11,"count":24}},{"name":"Tread_13","animation":{"type":"beltSlat","index":12,"count":24}},{"name":"Tread_14","animation":{"type":"beltSlat","index":13,"count":24}},{"name":"Tread_15","animation":{"type":"beltSlat","index":14,"count":24}},{"name":"Tread_16","animation":{"type":"beltSlat","index":15,"count":24}},{"name":"Tread_17","animation":{"type":"beltSlat","index":16,"count":24}},{"name":"Tread_18","animation":{"type":"beltSlat","index":17,"count":24}},{"name":"Tread_19","animation":{"type":"beltSlat","index":18,"count":24}},{"name":"Tread_20","animation":{"type":"beltSlat","index":19,"count":24}},{"name":"Tread_21","animation":{"type":"beltSlat","index":20,"count":24}},{"name":"Tread_22","animation":{"type":"beltSlat","index":21,"count":24}},{"name":"Tread_23","animation":{"type":"beltSlat","index":22,"count":24}},{"name":"Tread_24","animation":{"type":"beltSlat","index":23,"count":24}},{"name":"SkinHalo","animation":{"type":"aura","phase":0.0}},{"name":"SkinHalo_02","animation":{"type":"aura","phase":0.22}},{"name":"SkinHalo_03","animation":{"type":"aura","phase":0.44}},{"name":"SkinHalo_04","animation":{"type":"aura","phase":0.66}},{"name":"SkinHalo_05","animation":{"type":"aura","phase":0.88}},{"name":"SkinHalo_06","animation":{"type":"aura","phase":1.1}},{"name":"SkinHalo_07","animation":{"type":"aura","phase":1.32}},{"name":"SkinHalo_08","animation":{"type":"aura","phase":1.54}},{"name":"FloatingMintEgg_LowerShell","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":0.3,"spin":0}},{"name":"FloatingMintEgg_UpperShell","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":0.3,"spin":0}},{"name":"FloatingMintEgg_PaintedBand","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":0.3,"spin":0}},{"name":"FloatingLilacEgg_LowerShell","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":2.2,"spin":0}},{"name":"FloatingLilacEgg_UpperShell","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":2.2,"spin":0}},{"name":"FloatingLilacEgg_PaintedBand","animation":{"type":"float","amplitude":0.22,"axis":"y","cycles":1,"phase":2.2,"spin":0}},{"name":"BasketEgg_LowerShell","animation":{"type":"float","amplitude":0.14,"axis":"y","cycles":1,"phase":4.3,"spin":0}},{"name":"BasketEgg_UpperShell","animation":{"type":"float","amplitude":0.14,"axis":"y","cycles":1,"phase":4.3,"spin":0}},{"name":"BasketEgg_PaintedBand","animation":{"type":"float","amplitude":0.14,"axis":"y","cycles":1,"phase":4.3,"spin":0}}]}</string>
        </Properties>
