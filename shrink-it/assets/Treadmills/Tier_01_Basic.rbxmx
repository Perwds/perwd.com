":23,"count":32}},{"name":"Tread_25","animation":{"type":"beltSlat","index":24,"count":32}},{"name":"Tread_26","animation":{"type":"beltSlat","index":25,"count":32}},{"name":"Tread_27","animation":{"type":"beltSlat","index":26,"count":32}},{"name":"Tread_28","animation":{"type":"beltSlat","index":27,"count":32}},{"name":"Tread_29","animation":{"type":"beltSlat","index":28,"count":32}},{"name":"Tread_30","animation":{"type":"beltSlat","index":29,"count":32}},{"name":"Tread_31","animation":{"type":"beltSlat","index":30,"count":32}},{"name":"Tread_32","animation":{"type":"beltSlat","index":31,"count":32}}]}</string>
