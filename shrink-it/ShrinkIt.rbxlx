	add(m, "Wedge", V(19, 6, 8.6), V(0, 13.6, -4.3), roof, M.Slate)
	add(m, "Wedge", V(19, 6, 8.6), rot(V(0, 13.6, 4.3), 0, 180, 0), roof, M.Slate)
	add(m, "Block", V(2.2, 5, 2.2), V(5, 15, 3), C(150, 80, 70), M.Brick)
