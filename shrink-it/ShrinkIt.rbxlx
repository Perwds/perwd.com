	add(m, "Ball", V(8, 8, 8), V(0, 12, 0), g, M.Grass)
	add(m, "Ball", V(6, 6, 6), V(2.8, 10.5, 1), g:Lerp(C(255, 255, 255), 0.08), M.Grass)
